    "author": "agent",
    "code": "import cv2,numpy as np\ndef choose_bbox(gray):\n bw=(gray>parameters['search']['seedLevel']).astype('uint8');cs=cv2.findContours(bw,cv2.RETR_EXTERNAL,cv2.CHAIN_APPROX_NONE)[0]\n if not cs:return None\n return list(cv2.boundingRect(max(cs,key=cv2.contourArea)))\nwhy={'tool':{'reason':'建立兩條支路共用的灰階與搜尋域，避免歪斜和未焊各自重複前處理。','expectedEvidence':[{'kind':'artifact','type':'evidence','id':'shared_data','visuals':[{'id':'shared_overlay','caption':'共用搜尋域與灰階輸出；只表達共同前提。'}]}]},'parameters':[{'name':'search','source':'agent-proposal','reason':'沿用既有搜尋域設定，尚未跨照明比較。','verification':{'kind':'artifact','type':'evidence','id':'shared_data','visuals':[{'id':'shared_overlay','caption':'搜尋域實算。'}]}},{'name':'display','source':'agent-proposal','reason':'僅供核對，不參與分類。','verification':{'kind':'artifact','type':'evidence','id':'shared_data','visuals':[{'id':'shared_overlay','caption':'共用疊圖。'}]}}],'boundaries':[{'condition':'原圖可解碼且搜尋域存在；否則下游保持UNKNOWN。','check':{'kind':'artifact','type':'evidence','id':'shared_data','visuals':[{'id':'shared_overlay','caption':'搜尋域存在性。'}]},'onFailure':'UNKNOWN'}]}\nwith procedure('shared',name='共用影像與搜尋域',inputs={'image':image_records[0]['id']},outputs={'shared_gray':'shared_gray','shared_data':'shared_data','shared_overlay':'shared_overlay'},parameters=parameters,justification=why) as pr:\n with step('normalize',name='灰階與搜尋域',inputs={'image':image_records[0]['id']},outputs={'shared_gray':'shared_gray','shared_data':'shared_data','shared_overlay':'shared_overlay'},parameters=parameters,justification=why) as st:\n  gray=cv2.cvtColor(image,cv2.COLOR_BGR2GRAY);bbox=choose_bbox(gray);overlay=image.copy()\n  if bbox is not None:\n   x,y,w,h=bbox;cv2.rectangle(overlay,(x,y),(x+w,y+h),(0,200,255),2)\n  data={'bbox':bbox,'grayShape':[int(v) for v in gray.shape],'seedLevel':parameters['search']['seedLevel'],'sigma':parameters['search']['sigma'],'sharedFor':['objects','unweld_analysis'],'scope':'共同前提；不含最終分類'}\n  save_image('shared_gray',gray,section='tool');save_image('shared_overlay',overlay,section='tool');save_json('shared_data',data,section='parameters')\n  st.set_output('shared_gray','shared_gray');st.set_output('shared_data',data);st.set_output('shared_overlay','shared_overlay');st.set_output('boundaryChecks',[{'id':'shared_bbox','status':'PASS' if bbox is not None else 'FAIL','actual':bbox,'threshold':'one connected search domain'}])\nresult={'valid':True,'bbox':bbox,'shared_data':data}\n",
